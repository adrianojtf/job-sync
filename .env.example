# Copie este arquivo para .env e preencha os valores obrigatórios.
# OpenAI — usado para extrair, adaptar e gerar textos de currículo.
OPENAI_API_KEY=sua_chave_aqui
OPENAI_MODEL=gpt-6-luna
# TypeSafe (Jev) — usado para avaliar descrições de vaga e experiências.
TYPESAFE_API_KEY=sua_chave_aqui
TYPESAFE_MODEL=jev-1.14.0
# PostgreSQL — formato: postgresql://usuario:senha@host:5432/banco (as tabelas são criadas na subida da API).
DATABASE_URL=postgresql://job_sync:troque_a_senha@localhost:5432/job_sync
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:5173). Vazio ou * libera todas.
CORS_ORIGINS=*
# --- Autenticação (JOB-0013) ---
# Login com Google (OAuth 2.0 / OpenID Connect). Sem as duas chaves, o botão "Entrar com Google" some.
# Crie o cliente em console.cloud.google.com > APIs e serviços > Credenciais (tipo "Aplicativo da Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL pública do frontend: destino dos redirecionamentos e dos links enviados por e-mail.
AUTH_BASE_URL_FRONTEND=http://localhost:8080
# Base do redirecionamento do Google (padrão: AUTH_BASE_URL_FRONTEND). A URI final é
# <base>/v1/provedores/google/retorno e precisa estar cadastrada no cliente OAuth.
# AUTH_REDIRECT_BASE_URL=http://localhost:8080
# Cookie de sessão só por HTTPS. Use true em produção; deixe false em http://localhost.
AUTH_COOKIE_SECURE=false
# Prazos da sessão, em dias.
AUTH_SESSAO_INATIVIDADE_DIAS=7
AUTH_SESSAO_MAXIMA_DIAS=30
# Cabeçalho em que o proxy informa o IP real do cliente (o Nginx do compose usa X-Forwarded-For).
# Sem isso, o limite de tentativas por IP vê todos os usuários com o IP do proxy.
# AUTH_CABECALHO_IP_CLIENTE=X-Forwarded-For
# Login legado por identificador, sem senha. SOMENTE desenvolvimento e testes: nunca em produção.
AUTH_LOGIN_SIMPLES_HABILITADO=false
# E-mail (confirmação de cadastro e redefinição de senha). Sem SMTP_HOST, os links só aparecem no log.
# Para testar localmente: docker compose --profile dev up (Mailpit) com SMTP_HOST=mailpit,
# SMTP_PORT=1025 e SMTP_STARTTLS=false; a caixa de entrada fica em http://localhost:8025.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=nao-responda@seu-dominio.com
# SMTP_STARTTLS=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
