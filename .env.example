# Copie este arquivo para .env e preencha os valores obrigatórios.
# OpenAI — usado para extrair, adaptar e gerar textos de currículo.
OPENAI_API_KEY=sua_chave_aqui
OPENAI_MODEL=gpt-6-luna
# TypeSafe (Jev) — usado para avaliar descrições de vaga e experiências.
TYPESAFE_API_KEY=sua_chave_aqui
TYPESAFE_MODEL=jev-1.14.0
DATABASE_PATH=storage/job_sync.db
# Origens permitidas no CORS, separadas por vírgula (ex.: http://localhost:5173). Vazio ou * libera todas.
CORS_ORIGINS=*
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
