            "{{base_url}}"
          ],
          "path": [
            "v1",
            "curriculos",
            "{{curriculo_id}}",
            "adaptacoes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"descricao_vaga\": \"Desenvolvedor Python Senior com FastAPI, Cloud e experiencia em times distribuidos.\", \"idioma_alvo\": \"pt\", \"cargo_alvo\": \"Engenheiro de Software\", \"empresa_alvo\": \"TechCorp\", \"pdf_base64\": \"{{pdf_base64}}\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Resposta valida (sucesso ou erro controlado)', () => pm.expect([200,422,500,503]).to.include(pm.response.code));",
              "if (pm.response.code === 200) { pm.test('Campos de adaptacao presentes', () => { const j = pm.response.json(); pm.expect(j).to.have.property('nome_arquivo'); pm.expect(j).to.have.property('pdf_base64'); pm.expect(j).to.have.property('nome_completo'); }); }",
              "if (pm.response.code !== 200) { pm.test('Problem Details em erro', () => { const j = pm.response.json(); pm.expect(j).to.have.property('status'); pm.expect(j).to.have.property('detail'); }); }"
            ]
          }
        }
      ]
