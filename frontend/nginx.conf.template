# Processado pelo entrypoint oficial do Nginx: ${API_UPSTREAM} vem da variável de ambiente.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Rotas de IA podem levar até ~3 minutos (mesmo limite do cliente HTTP da UI).
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        # PDFs de até 5 MB viajam em base64 (~6,7 MB).
        client_max_body_size 10m;
    }

    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA: rotas do React Router caem no index.html.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
    }
}
